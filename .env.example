# Set this to the complete downloaded model directory.
# Linux example: /srv/models/clef-flash-NVFP4
# Windows example: E:/LLMRoot/clef-flash-NVFP4
CLEF_MODEL_DIR=./models/clef-flash-NVFP4
CLEF_HOST_PORT=18190
CLEF_BIND_ADDRESS=127.0.0.1
CLEF_MAX_MODEL_LEN=4096
CLEF_KV_CACHE_GIB=0.5
CLEF_MAX_PENDING_REQUESTS=16
